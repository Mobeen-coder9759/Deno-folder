# Heroku: Settings -> Reveal Config Vars -> DATABASE_URL
DATABASE_URL=postgres://user:pass@host:5432/dbname
# 32+ chars, e.g.  openssl rand -base64 48   (the app refuses to issue/verify tokens without it)
JWT_SECRET=
# Exact origins only (comma-separated). Do NOT use https://*.lovable.app: that domain is shared by every Lovable user.
# Include the Lovable preview URL AND your published URL. Empty = every browser call is refused (403).
ALLOWED_ORIGINS=https://id-preview--7e22ef73-643c-4a4d-a9cc-8a9f452ae819.lovable.app
# /auth/register is DISABLED unless this is set. When set, callers must send it as registration_key.
REGISTRATION_KEY=
# Default clinic time zone (each clinic can change its own in Settings)
CLINIC_TZ=Asia/Karachi
# Optional tuning
# PG_POOL_MAX=4
# TRUST_PROXY_HOPS=1
# Local dev database only (no SSL). Leave unset in production.
# DB_SSL=off
